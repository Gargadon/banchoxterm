---
import { Image } from 'astro:assets';
import { useTranslations, type Locale } from '../i18n/translations';
import banchoxtermScreenshot from '../assets/banchoxterm.png';

interface Props {
  lang?: Locale;
}

const { lang = 'es' } = Astro.props;
const t = useTranslations(lang);
const homePath = lang === 'es' ? '' : `/${lang}`;
---

<section class="hero-section">
  <div class="container hero-container">
    <div class="hero-badge-row">
      <div class="badge badge-cyan">
        <span class="pulse-dot"></span>
        <span>{t.hero.badgeOpenSource}</span>
      </div>
      <div class="badge badge-green">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <polyline points="20 6 9 17 4 12"></polyline>
        </svg>
        <span>{t.hero.badgeNoElectron}</span>
      </div>
    </div>

    <h1 class="hero-title">
      {t.hero.titleLine1} <br />
      <span class="gradient-text">{t.hero.titleLine2}</span>
    </h1>

    <p class="hero-subtitle">
      {t.hero.subtitle}
    </p>

    <div class="hero-cta-group">
      <a href={`${homePath}#instalacion`} class="btn btn-primary btn-large">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
          <polyline points="7 10 12 15 17 10"></polyline>
          <line x1="12" y1="15" x2="12" y2="3"></line>
        </svg>
        <span>{t.hero.ctaDownload}</span>
      </a>

      <a href="https://github.com/Gargadon/banchoxterm" target="_blank" rel="noopener noreferrer" class="btn btn-secondary btn-large">
        <svg height="20" width="20" viewBox="0 0 16 16" fill="currentColor">
          <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"></path>
        </svg>
        <span>{t.hero.ctaGitHub}</span>
      </a>
    </div>

    <!-- Quick terminal clone copy -->
    <div class="quick-install-box">
      <span class="quick-install-label">{t.hero.quickCloneLabel}</span>
      <code class="quick-code">git clone git@github.com:Gargadon/banchoxterm.git && cd banchoxterm</code>
      <button class="copy-trigger" data-copy="git clone git@github.com:Gargadon/banchoxterm.git && cd banchoxterm" title="Copiar" data-copied-text={t.hero.copied}>
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
          <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
        </svg>
      </button>
    </div>

    <!-- Real BanchoXterm Screenshot Showcase -->
    <div class="terminal-showcase glass-panel" id="demo">
      <Image
        src={banchoxtermScreenshot}
        alt="BanchoXterm Screenshot"
        class="showcase-image"
        width="1920"
        height="993"
        loading="eager"
        fetchpriority="high"
        decoding="async"
      />
    </div>
  </div>
</section>

<script>
  // Copy buttons
  document.querySelectorAll('.copy-trigger').forEach(btn => {
    btn.addEventListener('click', async () => {
      const text = btn.getAttribute('data-copy');
      const copiedNotice = btn.getAttribute('data-copied-text') || '✓ Copiado';
      if (text) {
        await navigator.clipboard.writeText(text);
        const original = btn.innerHTML;
        btn.innerHTML = `<span style="color: #10b981; font-size: 11px; font-weight: 600;">${copiedNotice}</span>`;
        setTimeout(() => {
          btn.innerHTML = original;
        }, 2000);
      }
    });
  });
</script>

<style>
  .hero-section {
    padding: 4.5rem 0 3.5rem 0;
    position: relative;
  }

  .hero-container {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .hero-badge-row {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
    margin-bottom: 1.5rem;
  }

  .pulse-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--accent-cyan);
    box-shadow: 0 0 10px var(--accent-cyan);
    animation: pulse 2s infinite;
  }

  @keyframes pulse {
    0%, 100% { transform: scale(1); opacity: 1; }
    50% { transform: scale(1.4); opacity: 0.5; }
  }

  .hero-title {
    font-size: 2.75rem;
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -0.03em;
    max-width: 900px;
    margin-bottom: 1.25rem;
  }

  @media (min-width: 768px) {
    .hero-title {
      font-size: 3.75rem;
    }
  }

  .hero-subtitle {
    font-size: 1.15rem;
    line-height: 1.65;
    color: var(--text-muted);
    max-width: 780px;
    margin-bottom: 2.25rem;
  }

  .hero-cta-group {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    justify-content: center;
    margin-bottom: 2rem;
  }

  .btn-large {
    padding: 0.85rem 1.75rem;
    font-size: 1.05rem;
  }

  /* Quick install snippet */
  .quick-install-box {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    background: rgba(16, 22, 34, 0.9);
    border: 1px solid var(--border-color);
    padding: 0.5rem 1rem;
    border-radius: var(--radius-md);
    margin-bottom: 3.5rem;
    max-width: 95%;
  }

  .quick-install-label {
    font-size: 0.8rem;
    color: var(--text-dim);
    text-transform: uppercase;
    font-weight: 700;
    letter-spacing: 0.05em;
  }

  .quick-code {
    font-size: 0.875rem;
    color: var(--accent-cyan);
    overflow-x: auto;
    white-space: nowrap;
  }

  .copy-trigger {
    color: var(--text-muted);
    padding: 4px;
    display: flex;
    align-items: center;
    transition: color 0.2s;
  }
  .copy-trigger:hover {
    color: #fff;
  }

  /* Real BanchoXterm Screenshot Showcase */
  .terminal-showcase {
    width: 100%;
    max-width: 1100px;
    background: #0d121c;
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.12);
    box-shadow: 0 25px 60px -15px rgba(0, 0, 0, 0.7), 0 0 50px -10px rgba(6, 182, 212, 0.2);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .terminal-showcase:hover {
    transform: translateY(-3px);
    box-shadow: 0 30px 70px -15px rgba(0, 0, 0, 0.8), 0 0 60px -5px rgba(6, 182, 212, 0.3);
  }

  .showcase-image {
    width: 100%;
    height: auto;
    display: block;
    border-radius: inherit;
  }
</style>
