---
import { useTranslations, type Locale } from '../i18n/translations';

interface Props {
  lang?: Locale;
}

const { lang = 'es' } = Astro.props;
const t = useTranslations(lang);
---

<section class="comparison-section">
  <div class="container">
    <div class="comparison-wrapper glass-panel">
      <div class="comparison-text">
        <span class="section-tag">{t.comparison.tag}</span>
        <h2 class="comparison-title">{t.comparison.title}</h2>
        <p class="comparison-desc">
          {t.comparison.desc1}
        </p>
        <p class="comparison-desc">
          {t.comparison.desc2}
        </p>

      </div>

      <div class="comparison-table-wrapper">
        <table class="comparison-table">
          <thead>
            <tr>
              <th>{t.comparison.tableHeaderFeature}</th>
              <th class="col-highlight">{t.comparison.tableHeaderApp}</th>
              <th>{t.comparison.tableHeaderOther}</th>
            </tr>
          </thead>
          <tbody>
            {t.comparison.rows.map(([feature, app, other]) => (
              <tr>
                <th scope="row">{feature}</th>
                <td class="col-highlight"><strong>{app}</strong></td>
                <td>{other}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </div>
</section>

<style>
  .comparison-section {
    padding: 5rem 0;
  }

  .comparison-wrapper {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
    padding: 3rem;
    background: linear-gradient(135deg, rgba(16, 22, 34, 0.8), rgba(23, 33, 51, 0.8));
    align-items: center;
  }

  @media (min-width: 960px) {
    .comparison-wrapper {
      grid-template-columns: 1fr 1fr;
    }
  }

  .comparison-title {
    font-size: 2rem;
    font-weight: 800;
    color: #fff;
    margin-bottom: 1.25rem;
    line-height: 1.25;
  }

  .comparison-desc {
    color: var(--text-muted);
    font-size: 1rem;
    line-height: 1.65;
    margin-bottom: 1.25rem;
  }

  /* Table styling */
  .comparison-table-wrapper {
    overflow-x: auto;
  }

  .comparison-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.9rem;
    text-align: left;
  }

  .comparison-table th,
  .comparison-table td {
    padding: 0.9rem 1rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
  }

  .comparison-table th {
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--text-dim);
  }

  .comparison-table tbody th { font-size: .9rem; text-transform: none; letter-spacing: normal; color: var(--text-muted); font-weight: 500; }

  td.col-highlight { color: var(--accent-cyan); }

  .col-highlight {
    background: rgba(6, 182, 212, 0.06);
    border-left: 1px solid rgba(6, 182, 212, 0.2);
    border-right: 1px solid rgba(6, 182, 212, 0.2);
  }
</style>
