---
import { useTranslations, type Locale } from '../i18n/translations';

interface Props {
  lang?: Locale;
}

const { lang = 'es' } = Astro.props;
const t = useTranslations(lang);

const protocolIcons: Record<string, string> = {
  ssh: '/icons/terminal.svg',
  sftp: '/icons/folder.svg',
  serial: '/icons/serial.svg',
  ftp: '/icons/server.svg'
};
---

<section class="protocols-section" id="protocolos">
  <div class="container">
    <div class="section-header">
      <span class="section-tag">{t.protocols.tag}</span>
      <h2 class="section-title">{t.protocols.title}</h2>
      <p class="section-desc">
        {t.protocols.desc}
      </p>
    </div>

    <div class="protocols-grid">
      {t.protocols.items.map(proto => (
        <div class="protocol-card glass-panel">
          <div class="protocol-header">
            <div class="protocol-heading">
              <div class="protocol-icon-wrapper" aria-hidden="true">
                <img src={protocolIcons[proto.id]} alt="" width="24" height="24" class="protocol-icon" loading="lazy" decoding="async" />
              </div>
              <div>
                <span class="badge badge-cyan">{proto.badge}</span>
                <h3 class="protocol-title">{proto.title}</h3>
              </div>
            </div>
          </div>
          <p class="protocol-desc">{proto.desc}</p>
          <ul class="protocol-list">
            {proto.highlights.map(item => (
              <li class="protocol-list-item">
                <svg class="check-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                  <polyline points="20 6 9 17 4 12"></polyline>
                </svg>
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .protocols-section {
    padding: 6rem 0;
    position: relative;
    background: radial-gradient(circle at 50% 50%, rgba(99, 102, 241, 0.05), transparent 70%);
  }

  .protocols-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
  }

  @media (min-width: 768px) {
    .protocols-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .protocol-card {
    padding: 2.25rem;
    display: flex;
    flex-direction: column;
    background: rgba(16, 22, 34, 0.65);
    border: 1px solid var(--border-color);
  }

  .protocol-card:hover {
    border-color: rgba(99, 102, 241, 0.4);
  }

  .protocol-header {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-bottom: 1.25rem;
  }

  .protocol-heading {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .protocol-icon-wrapper {
    width: 48px;
    height: 48px;
    flex-shrink: 0;
    display: grid;
    place-items: center;
    border: 1px solid rgba(99, 102, 241, 0.28);
    border-radius: var(--radius-md);
    background: rgba(99, 102, 241, 0.12);
  }

  .protocol-icon {
    filter: brightness(0) saturate(100%) invert(70%) sepia(42%) saturate(4733%) hue-rotate(201deg) brightness(101%) contrast(94%);
  }

  .protocol-title {
    font-size: 1.6rem;
    font-weight: 700;
    color: #fff;
    margin-top: 0.55rem;
  }

  .protocol-desc {
    color: var(--text-muted);
    font-size: 0.975rem;
    line-height: 1.65;
    margin-bottom: 1.5rem;
  }

  .protocol-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-top: auto;
    padding-top: 1rem;
    border-top: 1px solid rgba(255, 255, 255, 0.05);
  }

  .protocol-list-item {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    font-size: 0.9rem;
    color: var(--text-main);
  }

  .check-icon {
    color: var(--accent-cyan);
    flex-shrink: 0;
    margin-top: 3px;
  }
</style>
