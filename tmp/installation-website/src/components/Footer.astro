---
import { useTranslations, type Locale } from '../i18n/translations';
import { installationPaths, installationGuide } from '../i18n/installation';

interface Props {
  lang?: Locale;
}

const { lang = 'es' } = Astro.props;
const t = useTranslations(lang);
const homePath = lang === 'es' ? '/' : `/${lang}/`;
---

<footer class="site-footer">
  <div class="container footer-container">
    <div class="footer-brand">
      <div class="footer-logo">
        <img src="/icons/logo.svg" alt="BanchoXterm" width="32" height="32" loading="lazy" decoding="async" />
        <span class="footer-title">Bancho<span class="gradient-text">Xterm</span></span>
      </div>
      <p class="footer-desc">
        {t.footer.desc}
      </p>
      <div class="license-tag">
        <span>{t.footer.license}</span>
      </div>
    </div>

    <div class="footer-links-group">
      <div class="footer-col">
        <span class="col-title">{t.footer.projectTitle}</span>
        <a href={installationPaths[lang]}>{installationGuide[lang].guideLink}</a>
        <a href="https://github.com/Gargadon/banchoxterm" target="_blank" rel="noopener noreferrer">{t.footer.repo}</a>
        <a href="https://github.com/Gargadon/banchoxterm/releases" target="_blank" rel="noopener noreferrer">{t.footer.releases}</a>
        <a href="https://github.com/Gargadon/banchoxterm/issues" target="_blank" rel="noopener noreferrer">{t.footer.issues}</a>
        <a href="https://github.com/Gargadon/banchoxterm/blob/main/LICENSE" target="_blank" rel="noopener noreferrer">{t.footer.licenseLink}</a>
      </div>

      <div class="footer-col">
        <span class="col-title">{t.footer.protocolsTitle}</span>
        <a href={`${homePath}#protocolos`}>SSH & X11 Forwarding</a>
        <a href={`${homePath}#protocolos`}>SFTP Explorer</a>
        <a href={`${homePath}#protocolos`}>Serial & ZMODEM</a>
        <a href={`${homePath}#protocolos`}>FTP & FTPS (TLS 1.3)</a>
      </div>

      <div class="footer-col">
        <span class="col-title">{t.footer.featuresTitle}</span>
        <a href={`${homePath}#caracteristicas`}>Multi-Input Broadcast</a>
        <a href={`${homePath}#caracteristicas`}>Live Remote Monitoring</a>
        <a href={`${homePath}#caracteristicas`}>SSH Tunnels (SOCKS5)</a>
        <a href={`${homePath}#caracteristicas`}>C++17 / Qt 6 Native</a>
      </div>
    </div>
  </div>

  <div class="footer-bottom">
    <div class="container bottom-content">
      <p>© {new Date().getFullYear()} {t.footer.copyright} <a href="https://github.com/Gargadon" target="_blank" rel="noopener noreferrer" class="author-link">Gargadon</a>.</p>
      <p class="built-with">{t.footer.madeWith}</p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--border-color);
    background: #080c14;
    padding-top: 4.5rem;
    position: relative;
  }

  .footer-container {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
    padding-bottom: 3.5rem;
  }

  @media (min-width: 860px) {
    .footer-container {
      grid-template-columns: 1.5fr 2.5fr;
    }
  }

  .footer-brand {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .footer-logo {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 1.25rem;
    font-weight: 700;
  }

  .footer-desc {
    color: var(--text-muted);
    font-size: 0.925rem;
    line-height: 1.6;
    max-width: 360px;
  }

  .license-tag {
    font-size: 0.8rem;
    color: var(--text-dim);
  }

  .footer-links-group {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
    gap: 2rem;
  }

  .footer-col {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .col-title {
    font-size: 0.8rem;
    text-transform: uppercase;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: #fff;
    margin-bottom: 0.25rem;
  }

  .footer-col a {
    color: var(--text-muted);
    font-size: 0.9rem;
    transition: color 0.2s ease;
  }

  .footer-col a:hover {
    color: var(--accent-cyan);
  }

  .footer-bottom {
    border-top: 1px solid rgba(255, 255, 255, 0.04);
    padding: 1.5rem 0;
    font-size: 0.85rem;
    color: var(--text-dim);
  }

  .bottom-content {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    justify-content: space-between;
    align-items: center;
    text-align: center;
  }

  @media (min-width: 640px) {
    .bottom-content {
      flex-direction: row;
      text-align: left;
    }
  }

  .author-link {
    color: var(--text-muted);
    text-decoration: underline;
  }

  .author-link:hover {
    color: var(--accent-cyan);
  }

  .built-with {
    font-size: 0.8rem;
  }
</style>
