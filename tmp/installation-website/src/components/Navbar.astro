---
import { useTranslations, type Locale } from '../i18n/translations';
import { installationPaths } from '../i18n/installation';

interface Props {
  lang?: Locale;
  installationPage?: boolean;
}

const { lang = 'es', installationPage = false } = Astro.props;
const t = useTranslations(lang);

const homePath = lang === 'es' ? '/' : `/${lang}/`;

const languages: { code: Locale; label: string; url: string }[] = [
  { code: 'es', label: 'ES', url: installationPage ? installationPaths.es : '/' },
  { code: 'en', label: 'EN', url: installationPage ? installationPaths.en : '/en' },
  { code: 'pt', label: 'PT', url: installationPage ? installationPaths.pt : '/pt' }
];
---

<header class="navbar-wrapper">
  <div class="container navbar-container">
    <a href={lang === 'es' ? '/' : `/${lang}`} class="brand">
      <img
        src="/icons/logo.svg"
        alt="BanchoXterm Logo"
        class="brand-logo"
        width="36"
        height="36"
        loading="eager"
        fetchpriority="high"
        decoding="async"
      />
      <span class="brand-name">Bancho<span class="brand-highlight">Xterm</span></span>
      <span class="badge badge-cyan release-tag">C++17 / Qt6</span>
    </a>

    <nav class="nav-links">
      <a href={`${homePath}#caracteristicas`} class="nav-link">{t.nav.features}</a>
      <a href={`${homePath}#protocolos`} class="nav-link">{t.nav.protocols}</a>
      <a href={`${homePath}#demo`} class="nav-link">{t.nav.preview}</a>
      <a href={installationPaths[lang]} class="nav-link" aria-current={installationPage ? 'page' : undefined}>{t.nav.install}</a>
    </nav>

    <div class="nav-actions">
      <!-- Language Switcher -->
      <div class="lang-switcher" aria-label={t.nav.langSelect}>
        {languages.map((l) => (
          <a
            href={l.url}
            class={`lang-pill ${lang === l.code ? 'active' : ''}`}
            title={l.label}
          >
            {l.label}
          </a>
        ))}
      </div>

      <a
        href="https://github.com/Gargadon/banchoxterm"
        target="_blank"
        rel="noopener noreferrer"
        class="btn btn-ghost github-btn"
        aria-label="GitHub Repository"
      >
        <svg height="20" width="20" viewBox="0 0 16 16" fill="currentColor">
          <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"></path>
        </svg>
        <span class="github-text">GitHub</span>
      </a>

      <a href={`${homePath}#instalacion`} class="btn btn-primary nav-cta">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
          <polyline points="7 10 12 15 17 10"></polyline>
          <line x1="12" y1="15" x2="12" y2="3"></line>
        </svg>
        <span>{t.nav.download}</span>
      </a>
    </div>
  </div>
</header>

<style>
  .navbar-wrapper {
    position: sticky;
    top: 0;
    z-index: 100;
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    background: rgba(10, 13, 20, 0.85);
    border-bottom: 1px solid var(--border-color);
    transition: all 0.3s ease;
  }

  .navbar-container {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 72px;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-weight: 700;
    font-size: 1.25rem;
    text-decoration: none;
    color: var(--text-main);
  }

  .brand-logo {
    display: block;
    filter: drop-shadow(0 0 12px rgba(6, 182, 212, 0.4));
    transition: transform 0.2s ease;
  }

  .brand:hover .brand-logo {
    transform: rotate(5deg) scale(1.05);
  }

  .brand-highlight {
    background: linear-gradient(135deg, #06b6d4, #818cf8);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .release-tag {
    font-size: 0.7rem;
    padding: 0.15rem 0.5rem;
    display: none;
  }

  @media (min-width: 640px) {
    .release-tag {
      display: inline-flex;
    }
  }

  .nav-links {
    display: none;
    align-items: center;
    gap: 1.75rem;
  }

  @media (min-width: 960px) {
    .nav-links {
      display: flex;
    }
  }

  .nav-link {
    font-size: 0.925rem;
    font-weight: 500;
    color: var(--text-muted);
    transition: color 0.2s ease;
  }

  .nav-link:hover {
    color: #fff;
  }

  .nav-actions {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  /* Language Switcher */
  .lang-switcher {
    display: flex;
    align-items: center;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid var(--border-color);
    border-radius: 9999px;
    padding: 2px;
    gap: 2px;
  }

  .lang-pill {
    padding: 0.2rem 0.5rem;
    font-size: 0.75rem;
    font-weight: 700;
    border-radius: 9999px;
    color: var(--text-muted);
    transition: all 0.2s ease;
  }

  .lang-pill:hover {
    color: #fff;
  }

  .lang-pill.active {
    background: var(--accent-cyan);
    color: #0b0f17;
  }

  .github-btn {
    padding: 0.55rem 0.85rem;
    font-size: 0.9rem;
  }

  .github-text {
    display: none;
  }

  @media (min-width: 480px) {
    .github-text {
      display: inline;
    }
  }

  .nav-cta {
    padding: 0.55rem 1.15rem;
    font-size: 0.9rem;
  }
</style>
